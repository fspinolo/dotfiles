set nocompatible
filetype plugin indent on

syntax on
set termguicolors
set background=dark
set number
set ruler
set expandtab
set tabstop=2
set shiftwidth=2
set backspace=indent,eol,start
set hlsearch
set incsearch
set cursorline

" Keep swapfiles out of working directories (// encodes full path in name)
set directory=~/.vim/swap//

colorscheme gruvbox

" !-- NERDTree --!

" Close vim if nerdtree is the only thing left open
autocmd BufEnter * if tabpagenr('$') == 1 && winnr('$') == 1 && exists('b:NERDTree') && b:NERDTree.isTabTree() | quit | endif

" Make the cursor land in the right place depending on if a file was
" specified. Always open NERDTree for the working directory.
autocmd StdinReadPre * let s:stad_in=1
autocmd VimEnter * NERDTree | if argc() > 0 || exists("s:std_in") | wincmd p | endif

" Toggle the pane with Ctrl+t
nnoremap <C-t> :NERDTreeToggle<CR>

" !-- /NERDTree --!

" !-- FZF --!

" Use the hombebrew fzf install
set rtp+=/opt/homebrew/opt/fzf

" Ctrl+p for file browser
nnoremap <C-p> :Files<CR>
" Ctrl+f for ripgrep
nnoremap <C-f> :RG<CR>

" !-- /FZF --!

" !-- YCM --!

" Ctrl+j for Jump-to-Definition (GoTo falls back to declaration/references
" instead of erroring when no definition exists under the cursor)
nnoremap <C-j> :YcmCompleter GoTo<CR>

" Register out-of-tree LSP servers with YCM. bash-language-server is
" installed globally via npm (see ~/.Brewfile) and started over stdio.
let g:ycm_language_server =
  \ [
  \   {
  \     'name': 'bash',
  \     'cmdline': [ 'bash-language-server', 'start' ],
  \     'filetypes': [ 'sh' ],
  \   }
  \ ]

" !-- /YCM --!

" !-- Git review --!

" Base to diff a dev-session branch against: the merge-base with
" origin/master, so :Review shows everything this branch changed
" (committed and uncommitted), not commits that landed on master since.
function! s:ReviewBase() abort
  let l:base = systemlist('git merge-base origin/master HEAD')
  return (v:shell_error || empty(l:base)) ? 'origin/master' : l:base[0]
endfunction

" :Review            whole-branch diff vs the merge-base, read-only
" :Review --staged   (or any other `git diff` args) passed straight through
function! s:Review(args) abort
  let l:spec = empty(a:args) ? shellescape(s:ReviewBase()) : a:args
  let l:diff = system('git diff ' . l:spec)
  if v:shell_error && empty(l:diff)
    echohl ErrorMsg | echo 'Review: git diff failed' | echohl None
    return
  endif
  if empty(trim(l:diff))
    echo 'Review: no changes'
    return
  endif
  enew
  setlocal buftype=nofile bufhidden=wipe noswapfile nobuflisted filetype=diff
  call setline(1, split(l:diff, "\n"))
  setlocal nomodifiable
  normal! gg
endfunction

command! -nargs=? Review call s:Review(<q-args>)

" Quick whole-diff read; deep review via fugitive's status window.
nnoremap <leader>gd :Review<CR>
nnoremap <leader>gs :Git<CR>

" !-- /Git review --!
