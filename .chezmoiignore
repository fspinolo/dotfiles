# Repo documentation — not dotfiles to write into $HOME.
README.md
docs

# Secrets and machine-local state — never managed by chezmoi.
# Re-auth manually on a new machine (gh auth login, aws configure, etc).
.config/gh/hosts.yml
.config/bk.yaml
.config/cagent
.config/temporalio
.aws
.ssh

# Work-only files: applied only when machine == "work".
# Still committed to the repo (backed up), just not written out elsewhere.
{{ if ne .machine "work" }}
# settings.json is auto-mutated local state (permission approvals, model
# choice) and this snapshot is the work machine's — its allowlist, MCP
# grants, and hooks (two of which reference scripts not in this repo)
# would clobber the personal machine's live config. The work machine
# keeps managing it as a backup; other machines keep their own.
.claude/settings.json
.config/tmuxinator/devapp.yml
.config/tmuxinator/devbrief.yml
.config/tmuxinator/devpkg.yml
.config/tmuxinator/devroot.yml
.config/tmuxinator/devtree.yml
.config/zsh/work.zsh
.claude/skills/clean-dev-sessions
.claude/skills/dev-session
.claude/skills/weekly-update
{{ end }}

# Personal-only files: the dev-session functions in dev-personal.zsh
# would collide with work.zsh's, and dev.yml is only driven by them.
{{ if eq .machine "work" }}
.config/tmuxinator/dev.yml
.config/zsh/dev-personal.zsh
{{ end }}
