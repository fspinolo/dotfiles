# Repo documentation — not a dotfile to write into $HOME.
README.md

# Secrets and machine-local state — never managed by chezmoi.
# Re-auth manually on a new machine (gh auth login, aws configure, etc).
.config/gh/hosts.yml
.config/bk.yaml
.config/cagent
.config/temporalio
.aws
.ssh

# Work-only files: applied only when machine == "work".
# Still committed to the repo (backed up), just not written out elsewhere.
{{ if ne .machine "work" }}
.config/zsh/work.zsh
.claude/skills/clean-dev-sessions
.claude/skills/dev-session
.claude/skills/weekly-update
{{ end }}

# Personal-only files (the dev-session hooks would collide with work.zsh's).
{{ if eq .machine "work" }}
.config/zsh/dev-personal.zsh
{{ end }}
