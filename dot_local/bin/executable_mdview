#!/usr/bin/env bash
# Render a Markdown file to self-contained HTML and open it in a new
# browser tab. GitHub-flavored, fully offline (no server, no network).
# Usage: mdview <file.md>
#
# Depends on cmark-gfm (see ~/.Brewfile). The HTML is written to a
# stable per-source path under the cache dir, so re-running mdview on
# the same file overwrites in place and a browser refresh picks it up.
set -euo pipefail

src="${1:?usage: mdview <file.md>}"

if [[ ! -f "$src" ]]; then
  echo "mdview: no such file: $src" >&2
  exit 1
fi

# Resolve to an absolute path so the cache key is stable regardless of
# the directory mdview is invoked from.
abs="$(cd "$(dirname "$src")" && pwd)/$(basename "$src")"

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/mdview"
mkdir -p "$cache_dir"
key="$(printf '%s' "$abs" | shasum | cut -c1-12)"
out="$cache_dir/$(basename "${src%.*}")-$key.html"

title="$(basename "$src")"

# --unsafe passes through raw HTML embedded in the Markdown; safe for
# trusted local notes and needed for things like <details> blocks.
render() {
  cmark-gfm --unsafe \
    -e table -e strikethrough -e autolink -e tasklist -e footnotes \
    "$abs"
}

{
  cat <<HTML
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>$title</title>
<style>
  :root { color-scheme: light dark; }
  body {
    font: 16px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI",
      Helvetica, Arial, sans-serif;
    max-width: 820px;
    margin: 2.5rem auto;
    padding: 0 1.25rem;
    color: #1f2328;
    background: #ffffff;
  }
  h1, h2 { border-bottom: 1px solid #d0d7de; padding-bottom: .3em; }
  h1, h2, h3, h4 { line-height: 1.25; }
  a { color: #0969da; }
  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: .9em;
    background: rgba(129, 139, 152, .15);
    padding: .2em .4em;
    border-radius: 6px;
  }
  pre {
    background: #f6f8fa;
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
  }
  pre code { background: none; padding: 0; }
  blockquote {
    margin: 0;
    padding: 0 1em;
    color: #59636e;
    border-left: .25em solid #d0d7de;
  }
  table { border-collapse: collapse; }
  th, td { border: 1px solid #d0d7de; padding: .4em .8em; }
  img { max-width: 100%; }
  @media (prefers-color-scheme: dark) {
    body { color: #e6edf3; background: #0d1117; }
    a { color: #4493f8; }
    h1, h2 { border-color: #30363d; }
    pre { background: #161b22; }
    blockquote { color: #9198a1; border-color: #30363d; }
    th, td { border-color: #30363d; }
  }
</style>
</head>
<body>
HTML
  render
  cat <<'HTML'
</body>
</html>
HTML
} >"$out"

open "$out"
